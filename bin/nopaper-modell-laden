#!/usr/bin/env bash
# SPDX-License-Identifier: AGPL-3.0-or-later
# Laedt ein weiteres Ollama-Modell, obwohl Ollama per Netzsperre auf localhost beschraenkt ist.
#   nopaper-modell-laden numind/nuextract3:Q4_K_M      (als root)
# Ablauf: Sperre aufheben -> ollama pull -> Sperre wieder setzen. Bei Fehlern wird die Sperre trotzdem gesetzt.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "bitte als root ausfuehren" >&2; exit 1; }
[[ $# -ge 1 ]] || { echo "Aufruf: nopaper-modell-laden <modell> [<modell> ...]" >&2; exit 1; }

SPERRE=/etc/systemd/system/ollama.service.d/20-netlock.conf
# Ubuntu: nicht "localhost" (127.0.0.0/8), dort lauscht unter 127.0.0.53 systemd-resolved (E47)
LOKAL="localhost"
[[ "$(. /etc/os-release && echo "${ID:-}")" == "ubuntu" ]] && LOKAL="127.0.0.1 ::1"
sperren() {
  cat > "$SPERRE" <<EOF
[Service]
IPAddressDeny=any
IPAddressAllow=$LOKAL
EOF
  systemctl daemon-reload
  systemctl restart ollama
  echo "Ollama wieder auf localhost beschraenkt."
}
trap sperren EXIT

rm -f "$SPERRE"
systemctl daemon-reload
systemctl restart ollama
for _ in $(seq 30); do curl -fsS http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && break; sleep 2; done
for m in "$@"; do
  echo "==> lade $m"
  ollama pull "$m"
done
